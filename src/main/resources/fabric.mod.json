  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/smithing-templates"
  },
  "license": "MIT",
  "icon": "assets/smithing-templates-justfatlard/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.smithing_templates.Main"
    ]
  },
  "mixins": [
